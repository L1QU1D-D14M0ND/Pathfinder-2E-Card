{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ttrpg-sheet.local/schemas/content/pf1e/races.schema.json",
  "title": "PF1e race catalog",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name"],
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "name": { "type": "string", "minLength": 1 },
      "size": {
        "type": "string",
        "enum": [
          "fine",
          "diminutive",
          "tiny",
          "small",
          "medium",
          "large",
          "huge",
          "gargantuan",
          "colossal"
        ],
        "description": "Typical adult size. Apply stamps identity.size. Ability adjustments stay typed."
      },
      "source": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "book": { "type": "string" },
          "page": { "type": ["integer", "null"] },
          "rarity": { "enum": ["common", "uncommon", "rare", "unique"] }
        }
      }
    }
  }
}
