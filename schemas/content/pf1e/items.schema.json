{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ttrpg-sheet.local/schemas/content/pf1e/items.schema.json",
  "title": "PF1e item catalog",
  "description": "Mundane CRB item rows (ids, names, pounds, documentary weapon/armor stats). Fill-out is batches 16–21 in docs/pf1e-crb-pack-design.md §7. CRB Special tags (reach, brace, trip, disarm, monk, nonlethal, double) wait until after all weapon ids, one type per PR (§7.6). Magic weapons and armor are a later overlay on these ids — do not add plus-N copies.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "kind", "pounds"],
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "name": { "type": "string", "minLength": 1 },
      "kind": { "enum": ["weapon", "armor", "item"] },
      "pounds": { "type": "number", "minimum": 0 },
      "weapon": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "damageDice": { "type": "string" },
          "damageType": { "type": "string" },
          "critRange": { "type": "integer", "minimum": 1, "maximum": 20 },
          "critMultiplier": { "type": "integer", "minimum": 2 },
          "rangeFeet": { "type": ["number", "null"] }
        }
      },
      "armor": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "acBonus": { "type": "number" },
          "maxDex": { "type": ["number", "null"] },
          "armorCheckPenalty": { "type": "number", "maximum": 0 },
          "spellFailurePercent": { "type": "number", "minimum": 0 }
        }
      },
      "source": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "book": { "type": "string" },
          "page": { "type": ["integer", "null"] },
          "rarity": { "enum": ["common", "uncommon", "rare", "unique"] }
        }
      }
    }
  }
}
